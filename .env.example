# Optional. Everything works without a .env file (defaults shown below).
# Copy to .env only if you need to change something.

# Host ports
FRONTEND_PORT=5173
BACKEND_PORT=8080
DB_PORT=5435

# Database credentials (used by the db and backend containers)
DB_USERNAME=saldapp
DB_PASSWORD=saldapp

# Load fictional demo data on the first start (set to false to start empty)
SEED_DEMO_DATA=true
