# Backend URL used by the browser. Baked into the bundle at build time.
# Required in production builds unless VITE_DEMO_MODE=true.
VITE_API_BASE_URL=http://localhost:8080

# Demo mode: set to "true" to run WITHOUT a backend. Requests are answered by an
# in-browser mock with fictional data (state is kept in localStorage) and a banner
# explains it. Switching modes needs a rebuild/redeploy. See docs/demo-mode.md.
VITE_DEMO_MODE=false

VITE_APP_NAME=SaldApp
